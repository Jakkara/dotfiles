# GENERAL
alias eval-ssh='eval $(ssh-agent -s) && ssh-add ~/.ssh/id_rsa'
alias _reload="source ~/.alias; source ~/.zshrc"
alias nt="npm test"
alias tf="terraform"
alias v="nvim"
alias nv="nvim"
alias vim="nvim"
alias e="eza -la"
alias privates='vim ~/dotfiles/.private'
# Enable alias expansion with watch
alias watch='watch -c '

# GIT
alias gitl="git log"
alias gits="git status"
alias gitcam="git commit -am"
alias gitf="git fetch"
alias gfx='git commit --fixup $(git log $(git merge-base master HEAD)..HEAD --oneline| fzf| cut -d" " -f1)'

# Include dotfiles in ripgrep, except .git
alias rg="rg --hidden --glob '!.git'"

# FUNCTIONS

countdown() {
  date1=$((`date +%s` + $1)); 
  while [ "$date1" -ge `date +%s` ]; do 
    echo -ne "$(date -u --date @$(($date1 - `date +%s`)) +%H:%M:%S)\r";
    sleep 0.1
  done
}

stopwatch() {
  date1=`date +%s`; 
  while true; do 
    echo -ne "$(date -u --date @$((`date +%s` - $date1)) +%H:%M:%S)\r"; 
    sleep 0.1
  done
}

# usage:
# timer
# timer <time expression in seconds>
timer() {
    if [ $# -eq 0 ]
    then
        date1=`date +%s`;
        while true; do
            echo -ne "$(date -u --date @$((`date +%s` - $date1)) +%H:%M:%S)\r";
            sleep 0.1
        done
    else
        date1=$((`date +%s` + $@)); 
        while [ "$date1" -ge `date +%s` ]; do 
            echo -ne "$(date -u --date @$(($date1 - `date +%s`)) +%H:%M:%S)\r";
            sleep 0.1
        done
        echo "Finished: $(date +%H:%M:%S)"
    fi
}

gitreb() {
  if [ -z "$(git status --untracked-files=no --porcelain)" ]; then 
    git rebase -i HEAD~$1
  else 
    git stash
    git rebase -i HEAD~$1
    git stash pop
  fi
}
gitreb-master() {
    git pull --autostash --rebase origin master
}
gitreb-main() {
    git pull --autostash --rebase origin main
}
_is_dirty() {
    if [ -z "$(git status --untracked-files=no --porcelain)" ]; then 
        echo "True"
    else
        echo "False"
    fi
}

gitfuzz() {
    git fetch
    local branches branch
    branches=$(git branch -a) &&
    branch=$(echo "$branches" | fzf +s +m -e) &&
    if [ -z "$(git status --untracked-files=no --porcelain)" ]; then 
        git checkout $(echo "$branch" | sed "s:.* remotes/origin/::" | sed "s:.* ::")
    else
        git stash
        git checkout $(echo "$branch" | sed "s:.* remotes/origin/::" | sed "s:.* ::")
        git stash pop
    fi
}

# checkout git branch (including remote branches), sorted by most recent commit, limit 30 last branches
fgb() {
  local branches branch
  branches=$(git for-each-ref --count=30 --sort=-committerdate refs/heads/ --format="%(refname:short)") &&
  branch=$(echo "$branches" |
           fzf-tmux -d $(( 2 + $(wc -l <<< "$branches") )) +m) &&
  git checkout $(echo "$branch" | sed "s/.* //" | sed "s#remotes/[^/]*/##")
}

git-reset() {
  current=$(git symbolic-ref --short -q HEAD)
  read -sk "?Reset current branch? [y/N]: "
  case $REPLY in
  [yY])
      echo
      git checkout -b "temp"
      git branch -D $current
      git checkout $current
      git branch -D temp
      ;;
  esac
}

gnome-restart() {
    busctl --user call org.gnome.Shell /org/gnome/Shell org.gnome.Shell Eval s 'Meta.restart("Restarting...")'
} 

bdiff() {
  git diff --name-only --diff-filter=d | xargs bat --diff
}

bfuzz() {
  fzf --preview 'bat --color=always --style=numbers --line-range=:500 {}'
}

qalias() {
  if [ $# -eq 0 ]
    then
      echo "No name supplied"
      exit 1
  fi
  command=$(fc -nl -1)
  name=$1 
  echo "alias $name='$command'" >> ~/dotfiles/.private
  source ~/dotfiles/.private
}

cheat() {
  if [ $# -eq 0 ]
    then
      echo "No program supplied"
      exit 1
  fi
  program=$1 
  curl "cheat.sh/$program"
}
confirm() {
    whiptail --defaultno --yesno "Ihanko varma?" 12 80
}

memsum() {
    ps -eo size,command --sort -size | grep $1 | awk '{ hr=$1/1024 ; sum +=hr; echo $1} END {print sum}'
}
source ~/dotfiles/.private
